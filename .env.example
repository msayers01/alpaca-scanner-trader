# ---------------------------------------------------------------------------
# Vantage configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Startup trading mode: sim | paper | live   (sim needs no keys)
VANTAGE_MODE=sim

# Alpaca paper trading keys (https://app.alpaca.markets -> Paper account -> API keys)
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=

# Alpaca live trading keys. Live trading ALSO requires ALLOW_LIVE_TRADING=true
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALLOW_LIVE_TRADING=false

# Market data entitlements: iex (free) | sip (Algo Trader Plus)
ALPACA_STOCK_FEED=iex
# indicative (free, delayed trades) | opra (Algo Trader Plus, real-time)
ALPACA_OPTIONS_FEED=indicative

# Local LLM (any OpenAI-compatible server; Ollama default)
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.6:35b-a3b
LLM_TIMEOUT_S=45
LLM_MAX_CONCURRENCY=2

# Optional: Finnhub free key improves the earnings + economic calendar
FINNHUB_API_KEY=

# Intel (social / statements / prediction markets / VIX). Everything works without keys except Reddit's own API and X.
INTEL_ENABLED=true
# Reddit: create a free "script" app at https://www.reddit.com/prefs/apps (without it the public endpoint is tried and is often blocked)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# X (Twitter) official API v2 bearer token — paid tiers only; logged-out scraping of x.com is NOT used
X_BEARER_TOKEN=

# Server
HOST=127.0.0.1
PORT=8765
WS_FLUSH_MS=50

# Risk-free rate used in option maths (annual, decimal)
RISK_FREE_RATE=0.04

# Default scan/trade universe (comma separated)
UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD,AVGO,NFLX,JPM,XLF,XLE,SMH,COIN,PLTR,UBER
